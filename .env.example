# Copie para .env e preencha. O servidor lê este arquivo ao iniciar.

# ID do cliente OAuth do Google (Google Cloud Console > APIs e serviços > Credenciais)
GOOGLE_CLIENT_ID=

# E-mails dos organizadores (podem criar torneios e confirmar doações), separados por vírgula
ADMIN_EMAILS=seuemail@gmail.com

# Pix manual: sua chave Pix (aparece para quem for doar; você confirma no painel)
PIX_KEY=

# Pix automático (opcional): Access Token de produção do Mercado Pago
MP_ACCESS_TOKEN=

# Login de teste sem Google (use só para testar; deixe 0 quando for jogar de verdade)
DEV_LOGIN=0
